        "Mme",
        "M."
      ],
      "description": "Civilit\u00e9 du membre"
    },
    "prenom": {
      "type": "string",
      "description": "Pr\u00e9nom du membre"
    },
    "nom": {
      "type": "string",
      "description": "Nom du membre"
    },
    "profession": {
      "type": "string",
      "enum": [
